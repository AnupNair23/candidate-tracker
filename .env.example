# ---------------------------------------------------------------------------
# Ascendia sourcing agent — configuration (read by backend/app/config.py)
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Thinking depth for query parsing / candidate assessment: low | medium | high | xhigh | max
CLAUDE_EFFORT_INTENT=
CLAUDE_EFFORT_ASSESS=
# Server-side refusal fallback (re-runs a declined request on another model)
CLAUDE_FALLBACKS_ENABLED=
# claude = real Claude calls; stub = deterministic keyword matcher for UI dev (labelled in the UI)
LLM_MODE=

# --- JobDiva (API v1) -------------------------------------------------------
JOBDIVA_BASE_URL=
JOBDIVA_CLIENT_ID=
JOBDIVA_USERNAME=
JOBDIVA_PASSWORD=
# JobDiva page size for paged calls
JOBDIVA_PAGE_SIZE=
# Concurrency / pacing / retries (429 → Retry-After or exponential backoff)
JOBDIVA_MAX_CONCURRENCY=
JOBDIVA_MIN_INTERVAL_S=
JOBDIVA_MAX_RETRIES=
# BI endpoints (/api/bi, /apiv2/bi): the only JobDiva source of candidate profile, resume text, notes, work history
JOBDIVA_USE_BI=true
# Serve a synthetic dataset instead of calling JobDiva (dev/demo only)
JOBDIVA_MOCK=

# --- Search pipeline --------------------------------------------------------
SEARCH_CALL_BUDGET=
POOL_TARGET=
# Candidates reviewed in depth (resume + notes + history fetched per candidate)
STAGE2_TOP_N=
ASSESS_BATCH_SIZE=
ASSESS_CONCURRENCY=
SHORTLIST_SIZE=
SEARCH_DEADLINE_S=
# Re-run ranking on the last search snapshot without calling JobDiva (prompt tuning)
SNAPSHOT_REPLAY=

# --- Deploy -----------------------------------------------------------------
# HTTP basic auth for the whole app (UI + API; only GET /healthz is open). Set both to enable; leave blank for local dev.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Built frontend directory served by FastAPI (the Docker image sets this). Blank locally: Vite proxies /api.
FRONTEND_DIST=
